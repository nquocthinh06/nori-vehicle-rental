{
  "name": "nori-vehicle-rental",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "payload build",
    "start": "next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check src/ tests/ scripts/ docs/audit/",
    "lint": "node scripts/static-lint.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test:admin": "node scripts/test-admin-isolated.mjs",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/rental-rules.test.mjs tests/rbac-access.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/run-e2e-isolated.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "4.0.0-beta.8",
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.8",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.8",
    "@payloadcms/plugin-mcp": "4.0.0-beta.8",
    "@payloadcms/richtext-lexical": "4.0.0-beta.8",
    "@payloadcms/translations": "4.0.0-beta.8",
    "@payloadcms/ui": "4.0.0-beta.8",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "payload": "4.0.0-beta.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.17"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
