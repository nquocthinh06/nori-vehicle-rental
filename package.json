    "@types/node": "24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
