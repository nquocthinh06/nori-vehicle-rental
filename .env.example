# NORI Vehicle Rental - Environment Configuration Example
# Copy this file to .env and configure values before starting the application.

# Database URI (SQLite database path)
DATABASE_URI=file:./nori.db
# Optional explicit SQLite file path for scripts and healthcheck
NORI_SQLITE_PATH=./nori.db

# Payload CMS Secret (Required in production: 32+ characters random string)
PAYLOAD_SECRET=your-secure-random-payload-secret-at-least-32-chars-long
# App session cookie secret (Recommended in production: distinct 32+ char secret)
NORI_SESSION_SECRET=your-distinct-random-session-secret-at-least-32-chars

# Public Site URL (HTTPS domain in production, e.g. https://nori.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Port configuration (defaults to 3000)
PORT=3000

# Set to 1 in clean commercial production environments to prevent demo fleet/article seeding
# NORI_DISABLE_DEMO_SEED=1

# Optional external booking confirmation webhook (degrades safely if omitted)
# NORI_NOTIFY_WEBHOOK_URL=https://hooks.example.com/nori-bookings

# Optional: Admin bootstrap credentials (used only for initial setup script)
# NORI_ADMIN_EMAIL=admin@nori.vn
# NORI_ADMIN_PASSWORD=change-this-to-a-strong-password
