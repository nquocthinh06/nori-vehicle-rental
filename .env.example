# ===========================================================================
# NORI Vehicle Rental — Central Environment Configuration
# ===========================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# RULE: NEVER put server secrets (passwords, tokens, API keys) into NEXT_PUBLIC_* variables.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Server Runtime & Network Binding
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Canonical Public URLs (used for metadata, links, and payment redirects)
# In production with Cloudflare Tunnel, set to your official HTTPS domain or Quick Tunnel URL:
#   APP_URL=https://nori.vn
#   NEXT_PUBLIC_APP_URL=https://nori.vn
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowed Origins (Comma-separated list for CSRF & CORS verification)
# Example: https://nori.vn,https://staging.nori.vn,http://192.168.1.100:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Override auto-detected LAN IPv4 when running `pnpm dev:lan`
# Leave unset for automatic Wi-Fi / Ethernet detection.
# NORI_LAN_IP=192.168.1.100

# ---------------------------------------------------------------------------
# 2. Storage & Data Persistence (Decoupled from Source Code)
# ---------------------------------------------------------------------------
# Base data directory for persistent database, media, backups, and logs
# On Home Server, this can be an external persistent folder outside git:
#   Windows: C:\NORI\data
#   Linux:   /var/lib/nori/data
DATA_DIR=./data

# SQLite Database Location
# Both DATABASE_URL and DATABASE_URI are supported:
DATABASE_URL=file:./data/nori.db
DATABASE_URI=file:./data/nori.db
NORI_SQLITE_PATH=./data/nori.db

# Media Upload Storage Directory (Stores customer uploads, car photos, banners)
MEDIA_DIR=./data/media
NORI_MEDIA_DIR=./data/media

# Automated Hot Backups Directory
BACKUP_DIR=./backups
NORI_BACKUP_DIR=./backups
# Number of recent backups to keep automatically before pruning old ones (default: 14)
BACKUP_RETENTION_COUNT=14

# Logs Directory
LOG_DIR=./logs
NORI_LOG_DIR=./logs

# ---------------------------------------------------------------------------
# 3. Security Secrets & Credentials (SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# Payload CMS Secret (Required in production: 32+ characters random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=your-secure-random-payload-secret-at-least-32-chars-long

# App session cookie secret (32+ chars random string distinct from PAYLOAD_SECRET)
NORI_SESSION_SECRET=your-distinct-random-session-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# 4. Administrator Setup (Initial Bootstrap)
# ---------------------------------------------------------------------------
# Optional: Admin bootstrap credentials (used for initial setup script `pnpm seed:admin`)
# In production, change to your secure administrative email & complex password:
NORI_ADMIN_EMAIL=admin@nori.vn
NORI_ADMIN_PASSWORD=change-this-to-a-strong-password-min-8-chars

# Set to 1 in clean commercial production environments to prevent demo fleet/article seeding
# NORI_DISABLE_DEMO_SEED=1

# Optional external booking confirmation webhook (degrades safely if omitted)
# NORI_NOTIFY_WEBHOOK_URL=https://hooks.example.com/nori-bookings

# ---------------------------------------------------------------------------
# 5. Online Payment Integration (SePay + VietQR + Webhook + Mock Sandbox)
# ---------------------------------------------------------------------------
# Enable or disable online payment globally (defaults to true in MOCK/SANDBOX)
PAYMENT_ENABLED=true

# Active payment provider: SEPAY | MOCK | MANUAL
PAYMENT_PROVIDER=MOCK

# Payment environment mode: MOCK | SANDBOX | PRODUCTION (PRODUCTION is locked by default)
PAYMENT_MODE=MOCK
PAYMENT_PRODUCTION_APPROVED=false
PAYMENT_PUBLIC_BASE_URL=http://localhost:3000

# SePay credentials (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_)
SEPAY_API_KEY=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=1017588888
SEPAY_BANK_CODE=VCB
