node_modules/
.next/
out/
dist/
build/
.cache/

# Environment configurations & secrets
.env*
!.env.example

# Local SQLite databases & journals (Track canonical dev snapshot in dev-data/database/)
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
!dev-data/database/*.db
!dev-data/database/nori-dev.db
dev-data/database/*.db-*
dev-data/**/*.tmp*

# Runtime media uploads (keep version-controlled media/seed/ tracked in Git)
/media/*
!/media/seed/
/media/uploads/

# Runtime sync state & Backups & Test Artifacts
/data/runtime/
/data/backups/
/data/media/*
!/data/media/seed/
backups/
backups/postgres/
backups/media/
*.enc
nori-e2e-isolated.db*
.tmp-e2e-media/
test-results/
playwright-report/
playwright/.cache/
coverage/

# Cloudflare Tunnel credentials & tokens (Never commit to Git)
tunnel-credentials.json
*.pem
cert.pem
.cloudflared/
deploy/cloudflare/*.json
deploy/cloudflare/*.pem
deploy/cloudflare/cert.pem

# Logs & Diagnostics
logs/
*.log
*.tsbuildinfo
*-debug.log*

# Temporary files & runtime cache
.tmp/
.tmp-*
next-env.d.ts
.claude-replay.*
